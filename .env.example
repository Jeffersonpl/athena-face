# =============================================================================
# Athena Face - Configuracao Multi-Tenant
# =============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha com valores reais
# NUNCA commit o arquivo .env no repositorio!

# =============================================================================
# CONFIGURACOES DO SERVICO
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=false
LOG_LEVEL=INFO
WORKERS=1

# =============================================================================
# MODELO INSIGHTFACE
# =============================================================================
FACE_MODEL_NAME=buffalo_l
DEFAULT_THRESHOLD=0.4

# =============================================================================
# LIVENESS DETECTION
# =============================================================================
ENABLE_LIVENESS_CHECK=true
LIVENESS_BLUR_THRESHOLD=100.0
LIVENESS_BRIGHTNESS_MIN=50
LIVENESS_BRIGHTNESS_MAX=200

# Configuracoes avancadas de liveness
LIVENESS_BLINK_ENABLED=true
LIVENESS_BLINK_MIN_COUNT=2
LIVENESS_MOTION_ENABLED=true
LIVENESS_MOTION_MIN_FRAMES=10
LIVENESS_TEXTURE_ENABLED=true
LIVENESS_CHALLENGE_TIMEOUT_MS=10000
LIVENESS_MIN_CHALLENGE_TIME_MS=500

# =============================================================================
# CORS - Dominios permitidos (separar por virgula)
# =============================================================================
# Em producao, liste apenas os dominios permitidos
CORS_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com

# =============================================================================
# REDIS (Opcional - para rate limiting distribuido)
# =============================================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# METRICAS E MONITORAMENTO
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# TENANT 1: Exemplo
# =============================================================================
TENANT_EXEMPLO_DB_HOST=localhost
TENANT_EXEMPLO_DB_PORT=3306
TENANT_EXEMPLO_DB_NAME=face_exemplo
TENANT_EXEMPLO_DB_USER=app_user
TENANT_EXEMPLO_DB_PASS=CHANGE_ME_SECURE_PASSWORD
TENANT_EXEMPLO_API_KEY=GENERATE_WITH_scripts/generate_api_keys.py
TENANT_EXEMPLO_THRESHOLD=0.4
TENANT_EXEMPLO_RATE_LIMIT=100
TENANT_EXEMPLO_ACTIVE=true

# =============================================================================
# ADICIONE NOVOS TENANTS SEGUINDO O PADRAO ACIMA
# =============================================================================
# TENANT_XX_DB_HOST=
# TENANT_XX_DB_PORT=3306
# TENANT_XX_DB_NAME=
# TENANT_XX_DB_USER=
# TENANT_XX_DB_PASS=
# TENANT_XX_API_KEY=
# TENANT_XX_THRESHOLD=0.4
# TENANT_XX_RATE_LIMIT=100
# TENANT_XX_ACTIVE=true
